<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred yet: every domain is excluded, though the app now holds training records and
     run tracks. The policy for them is decided with the Room and sync work (A3). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
