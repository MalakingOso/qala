  {"name": "records bucket by the local date in their own offset", "reason": "Week of Monday 2026-09-14. A squat set at 2026-09-14T00:30+10:00 is Monday locally though it is Sunday 14:30 UTC; a set at 2026-09-20T23:30+10:00 is Sunday locally (13:30 UTC the same day); 2026-09-21T00:30+10:00 is the next Monday. One set at the default RPE 8 is 1.0*2.5 = 2.5 each.", "input": {"v": 1, "planned": [{"kind": "rest"}, {"kind": "rest"}, {"kind": "rest"}, {"kind": "rest"}, {"kind": "rest"}, {"kind": "rest"}, {"kind": "rest"}], "settings": {}, "weekStart": "2026-09-14", "records": [{"kind": "lift", "id": "a", "startedAt": "2026-09-14T00:30:00+10:00", "entries": [{"exerciseId": "squat", "sets": [{"weight": 100, "unit": "lb", "reps": 5, "rpe": null, "completed": true}]}]}, {"kind": "lift", "id": "b", "startedAt": "2026-09-20T23:30:00+10:00", "entries": [{"exerciseId": "squat", "sets": [{"weight": 100, "unit": "lb", "reps": 5, "rpe": null, "completed": true}]}]}, {"kind": "lift", "id": "c", "startedAt": "2026-09-21T00:30:00+10:00", "entries": [{"exerciseId": "squat", "sets": [{"weight": 100, "unit": "lb", "reps": 5, "rpe": null, "completed": true}]}]}]}, "expected": {"planned": [0, 0, 0, 0, 0, 0, 0], "done": [2.5, 0, 0, 0, 0, 0, 2.5], "warnings": []}, "tolerance": 1e-09},
