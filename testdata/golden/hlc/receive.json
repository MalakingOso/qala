{
  "fn": "hlc_receive",
  "version": 1,
  "oracle": "manual",
  "reason": "Hand-worked from Kulkarni et al. (2014): wall = max(local, remote, now); counter is max(both)+1 when local and remote tie the wall, local+1 or remote+1 when only one does, else 0. The result keeps the local node id and is greater than both inputs. A remote more than maxDriftMs ahead of now is rejected (a remote exactly maxDriftMs ahead is accepted).",
  "notes": "input {local, remote, nowMs, maxDriftMs}; expected {ok: clock} or {error: kind}. Clock values are {wallMs, counter, nodeId}. Canonical range: wallMs 0..=9999999999999, counter 0..=99999, nodeId non-empty ASCII graphic. W is 1790911800000 (2026-10-02T03:30:00Z). A day of drift is 86400000 ms. Results are {\"ok\": value} or {\"error\": kind}; error kinds are invalid_format, invalid_node_id, wall_out_of_range, counter_overflow, clock_drift.",
  "cases": [
    {"name": "local, remote and now tie: max counter + 1 (remote higher)", "input": {"local": {"wallMs": 1790911800000, "counter": 3, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 7, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 8, "nodeId": "n1"}}},
    {"name": "local, remote and now tie: max counter + 1 (local higher)", "input": {"local": {"wallMs": 1790911800000, "counter": 7, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 3, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 8, "nodeId": "n1"}}},
    {"name": "local and remote identical counters", "input": {"local": {"wallMs": 1790911800000, "counter": 4, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 4, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 5, "nodeId": "n1"}}},
    {"name": "local ahead of remote and now: local counter + 1", "input": {"local": {"wallMs": 1790911800005, "counter": 2, "nodeId": "n1"}, "remote": {"wallMs": 1790911800001, "counter": 9, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800005, "counter": 3, "nodeId": "n1"}}},
    {"name": "remote ahead of local and now: remote counter + 1", "input": {"local": {"wallMs": 1790911800000, "counter": 2, "nodeId": "n1"}, "remote": {"wallMs": 1790911805000, "counter": 9, "nodeId": "n2"}, "nowMs": 1790911801000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911805000, "counter": 10, "nodeId": "n1"}}},
    {"name": "now ahead of both: counter resets", "input": {"local": {"wallMs": 1790911800000, "counter": 2, "nodeId": "n1"}, "remote": {"wallMs": 1790911800001, "counter": 9, "nodeId": "n2"}, "nowMs": 1790911800100, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800100, "counter": 0, "nodeId": "n1"}}},
    {"name": "now ties local only: local counter + 1", "input": {"local": {"wallMs": 1790911800000, "counter": 4, "nodeId": "n1"}, "remote": {"wallMs": 1790911799990, "counter": 50, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 5, "nodeId": "n1"}}},
    {"name": "now ties remote only: remote counter + 1", "input": {"local": {"wallMs": 1790911799990, "counter": 4, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 50, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 51, "nodeId": "n1"}}},
    {"name": "physical clock behind both", "input": {"local": {"wallMs": 1790911800000, "counter": 4, "nodeId": "n1"}, "remote": {"wallMs": 1790911799999, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911795000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 5, "nodeId": "n1"}}},
    {"name": "physical clock behind, walls tie", "input": {"local": {"wallMs": 1790911800000, "counter": 4, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 2, "nodeId": "n2"}, "nowMs": 1790911795000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 5, "nodeId": "n1"}}},
    {"name": "echo of our own write", "input": {"local": {"wallMs": 1790911800000, "counter": 3, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 3, "nodeId": "n1"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 4, "nodeId": "n1"}}},
    {"name": "remote far in the past is never drift", "input": {"local": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 1, "nodeId": "n1"}}},
    {"name": "remote exactly one day ahead is accepted", "input": {"local": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1790998200000, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790998200000, "counter": 1, "nodeId": "n1"}}},
    {"name": "remote one ms past a day ahead is rejected", "input": {"local": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1790998200001, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"error": "clock_drift"}},
    {"name": "drift is measured against now, not the local clock", "input": {"local": {"wallMs": 1791775800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1790998200001, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"error": "clock_drift"}},
    {"name": "zero tolerance accepts a remote at now", "input": {"local": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 0}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 1, "nodeId": "n1"}}},
    {"name": "zero tolerance rejects one ms ahead", "input": {"local": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1790911800001, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 0}, "expected": {"error": "clock_drift"}},
    {"name": "local counter at the cap on a tie", "input": {"local": {"wallMs": 1790911800000, "counter": 99999, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"error": "counter_overflow"}},
    {"name": "remote counter at the cap on a tie", "input": {"local": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 99999, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"error": "counter_overflow"}},
    {"name": "local counter at the cap, local only ties", "input": {"local": {"wallMs": 1790911800000, "counter": 99999, "nodeId": "n1"}, "remote": {"wallMs": 1790911799999, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"error": "counter_overflow"}},
    {"name": "remote counter at the cap, remote only ties", "input": {"local": {"wallMs": 1790911799999, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 99999, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"error": "counter_overflow"}},
    {"name": "counter one below the cap", "input": {"local": {"wallMs": 1790911800000, "counter": 99998, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 99999, "nodeId": "n1"}}},
    {"name": "full counters on the losers are harmless when now is ahead", "input": {"local": {"wallMs": 1790911799999, "counter": 99999, "nodeId": "n1"}, "remote": {"wallMs": 1790911799998, "counter": 99999, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"ok": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}}},
    {"name": "remote wall negative", "input": {"local": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": -1, "counter": 0, "nodeId": "n2"}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"error": "wall_out_of_range"}},
    {"name": "remote node id empty", "input": {"local": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 0, "nodeId": ""}, "nowMs": 1790911800000, "maxDriftMs": 86400000}, "expected": {"error": "invalid_node_id"}},
    {"name": "now past the 13 digit range", "input": {"local": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}, "remote": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n2"}, "nowMs": 10000000000000, "maxDriftMs": 86400000}, "expected": {"error": "wall_out_of_range"}}
  ]
}
