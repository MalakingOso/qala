{
  "fn": "hlc_merge_field_laws",
  "version": 1,
  "oracle": "manual",
  "reason": "Hand-worked: three copies of one field whose clocks are all distinct (or equal with equal values), where merging in any order and any grouping must land on the highest clock. Proves commutativity, associativity and idempotence for a replayer that checks every permutation.",
  "notes": "input {a, b, c} are fields. For each of the 6 orderings (p, q, r) of the three: merge(merge(p, q), r) and merge(p, merge(q, r)) both equal expected; merge(p, q) equals merge(q, p); merge(p, p) equals p.",
  "cases": [
    {"name": "wall times decide", "input": {"a": {"value": "x", "hlc": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n1"}}, "b": {"value": "y", "hlc": {"wallMs": 1790911800001, "counter": 0, "nodeId": "n1"}}, "c": {"value": "z", "hlc": {"wallMs": 1790911800002, "counter": 0, "nodeId": "n1"}}}, "expected": {"value": "z", "hlc": {"wallMs": 1790911800002, "counter": 0, "nodeId": "n1"}}},
    {"name": "counters decide", "input": {"a": {"value": "x", "hlc": {"wallMs": 1790911800000, "counter": 5, "nodeId": "n1"}}, "b": {"value": "y", "hlc": {"wallMs": 1790911800000, "counter": 6, "nodeId": "n1"}}, "c": {"value": "z", "hlc": {"wallMs": 1790911800000, "counter": 7, "nodeId": "n1"}}}, "expected": {"value": "z", "hlc": {"wallMs": 1790911800000, "counter": 7, "nodeId": "n1"}}},
    {"name": "node ids decide", "input": {"a": {"value": "x", "hlc": {"wallMs": 1790911800000, "counter": 5, "nodeId": "n1"}}, "b": {"value": "y", "hlc": {"wallMs": 1790911800000, "counter": 5, "nodeId": "n2"}}, "c": {"value": "z", "hlc": {"wallMs": 1790911800000, "counter": 5, "nodeId": "n3"}}}, "expected": {"value": "z", "hlc": {"wallMs": 1790911800000, "counter": 5, "nodeId": "n3"}}},
    {"name": "wall beats counter beats node", "input": {"a": {"value": "x", "hlc": {"wallMs": 1790911800009, "counter": 0, "nodeId": "n1"}}, "b": {"value": "y", "hlc": {"wallMs": 1790911800000, "counter": 99999, "nodeId": "n9"}}, "c": {"value": "z", "hlc": {"wallMs": 1790911800009, "counter": 1, "nodeId": "a"}}}, "expected": {"value": "z", "hlc": {"wallMs": 1790911800009, "counter": 1, "nodeId": "a"}}},
    {"name": "one write seen twice", "input": {"a": {"value": "x", "hlc": {"wallMs": 1790911800000, "counter": 1, "nodeId": "n1"}}, "b": {"value": "x", "hlc": {"wallMs": 1790911800000, "counter": 1, "nodeId": "n1"}}, "c": {"value": "z", "hlc": {"wallMs": 1790911799999, "counter": 4, "nodeId": "n2"}}}, "expected": {"value": "x", "hlc": {"wallMs": 1790911800000, "counter": 1, "nodeId": "n1"}}},
    {"name": "range extremes", "input": {"a": {"value": "x", "hlc": {"wallMs": 0, "counter": 0, "nodeId": "n1"}}, "b": {"value": "y", "hlc": {"wallMs": 9999999999999, "counter": 99999, "nodeId": "n1"}}, "c": {"value": "z", "hlc": {"wallMs": 1790911800000, "counter": 0, "nodeId": "n2"}}}, "expected": {"value": "y", "hlc": {"wallMs": 9999999999999, "counter": 99999, "nodeId": "n1"}}},
    {"name": "phone and web edits", "input": {"a": {"value": "old", "hlc": {"wallMs": 1790911800000, "counter": 3, "nodeId": "phone"}}, "b": {"value": "new", "hlc": {"wallMs": 1790911800500, "counter": 0, "nodeId": "web"}}, "c": {"value": "mid", "hlc": {"wallMs": 1790911800250, "counter": 8, "nodeId": "phone"}}}, "expected": {"value": "new", "hlc": {"wallMs": 1790911800500, "counter": 0, "nodeId": "web"}}}
  ]
}
