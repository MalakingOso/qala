{
  "workspace": ["packages/*", "apps/web", "server"],
  "fmt": {
    "include": [
      "apps/web/src",
      "packages/core",
      "packages/engine",
      "packages/generator",
      "packages/llm",
      "packages/run",
      "packages/liftoscript/mod.ts",
      "packages/liftoscript/src/runtime.ts",
      "server",
      "scripts"
    ]
  },
  "lint": {
    "include": [
      "apps/web/src",
      "packages/core",
      "packages/engine",
      "packages/generator",
      "packages/llm",
      "packages/run",
      "packages/liftoscript/mod.ts",
      "packages/liftoscript/src/runtime.ts",
      "server",
      "scripts"
    ]
  },
  "tasks": {
    "dev": "deno run --watch --allow-all server/mod.ts",
    "build": "npm --prefix apps/web run build",
    "test": "deno test --allow-all packages/ server/ apps/web/src/logic/",
    "serve": "deno run --allow-all server/mod.ts",
    "vendor": "deno run --allow-all scripts/vendor_liftosaur.ts",
    "build:android": "bash -c 'source scripts/android-env.sh && apps/android/gradlew -p apps/android assembleDebug'",
    "gen:android": "deno run --allow-all scripts/tokens_to_kotlin.ts && deno run --allow-all scripts/lucide_to_kotlin.ts",
    "tiles:extract": "deno run --allow-all scripts/tiles_extract.ts",
    "dem:fetch": "deno run --allow-all scripts/dem_fetch.ts",
    "golden:liftoscript": "deno run -A scripts/golden_liftoscript.ts",
    "gen:liftoscript": "scripts/gen_liftoscript_testdata.sh",
    "fuzz:liftoscript": "deno run -A scripts/gen_program_fuzz.ts",
    "build:wasm": "scripts/build_wasm.sh",
    "smoke:wasm": "deno run -A scripts/wasm_smoke.ts"
  }
}
