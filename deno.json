{
  "workspace": [
    "packages/*",
    "apps/web",
    "server"
  ],
  "fmt": {
    "include": [
      "apps/web/src",
      "packages/core",
      "packages/engine",
      "packages/generator",
      "packages/llm",
      "packages/lspp",
      "server",
      "scripts"
    ]
  },
  "lint": {
    "include": [
      "apps/web/src",
      "packages/core",
      "packages/engine",
      "packages/generator",
      "packages/llm",
      "packages/lspp",
      "server",
      "scripts"
    ]
  },
  "tasks": {
    "dev": "deno run --watch --allow-all server/mod.ts",
    "build": "npm --prefix apps/web run build",
    "test": "deno test --allow-all packages/ server/ apps/web/src/logic/",
    "serve": "deno run --allow-all server/mod.ts",
    "build:android": "bash -c 'source scripts/android-env.sh && apps/android/gradlew -p apps/android assembleDebug'",
    "gen:android": "deno run --allow-all scripts/tokens_to_kotlin.ts && deno run --allow-all scripts/lucide_to_kotlin.ts && deno run --allow-all scripts/plates_to_android.ts",
    "gen:android-gear": "deno run --allow-all scripts/gear_to_kotlin.ts",
    "tiles:extract": "deno run --allow-all scripts/tiles_extract.ts",
    "dem:fetch": "deno run --allow-all scripts/dem_fetch.ts",
    "build:wasm": "scripts/build_wasm.sh"
  }
}
